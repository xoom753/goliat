<div class="has-text-centered">
    <h2>Legacy Person Activities</h2>
</div>

<%= simple_form_for :search, method: :get do |f| %>
    <div class="field is-horizontal">
        <div class="field-body">
            <%= f.input :date_from,
                        as: :date,
                        html5: true,
                        input_html: { name: :date_from, value: params[:date_from] }
            %>
            <%= f.input :date_to,
                        as: :date,
                        html5: true,
                        input_html: { name: :date_to, value: params[:date_to] }
            %>
            <div class="control is-narrow is-align-self-flex-end">
                <%= f.submit "Search", class: "button" %>
            </div>
        </div>
    </div>
<% end %>

<div class="my-2 has-text-right">
    <%=
        pluralize @legacy_person_activities.total_count, "record"
    %>
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>Nº</th>
            <th>Nombres</th>
            <th>Grupo</th>
            <th>Actividad</th>
            <th>Rango</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Duración</th>
        </tr>
    </thead>
    <tbody>
        <% @legacy_person_activities.each do |legacy_activity| %>
            <tr>
                <td>
                    <%= legacy_activity.row_number %>
                </td>
                <td>
                    <%= legacy_activity.legacy_person.nombres %>
                </td>
                <td>
                    <%= legacy_activity.legacy_activity_group.try(:nombre) %>
                </td>
                <td>
                    <%= legacy_activity.legacy_activity.try(:nombre) %>
                </td>
                <td>
                    <%= legacy_activity.activity_dates %>
                </td>
                <td>
                    <%= legacy_activity.start_date %>
                </td>
                <td>
                    <%= legacy_activity.end_date %>
                </td>
                <td>
                    <%= legacy_activity.duracion %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>

<%= paginate @legacy_person_activities %>
