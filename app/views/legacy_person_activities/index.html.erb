<div class="has-text-centered">
    <h2>Actividades PPL archivos</h2>
</div>

<%= simple_form_for :search, method: :get do |f| %>
    <div class="field is-horizontal">
        <div class="field-body">
            <%= f.input :date_from,
                        as: :date,
                        html5: true,
                        label: "Desde",
                        input_html: { name: :date_from, value: params[:date_from] }
            %>
            <%= f.input :date_to,
                        as: :date,
                        html5: true,
                        label: "Hasta",
                        input_html: { name: :date_to, value: params[:date_to] }
            %>

            <div class="control mr-2">
                <%= f.label :activity_group_id, "Eje", class: "label" %>

                <div class="select">
                    <%= f.input :activity_group_id,
                                as: :select,
                                label: false,
                                collection: ActivityGroup.all.map{|l| [l.nombre, l.id]},
                                selected: params[:activity_group_id],
                                include_blank: true,
                                input_html: { name: :activity_group_id }
                    %>
                </div>
            </div>

            <% if params[:activity_group_id].present? %>
                <div class="control mr-2">
                    <%= f.label :activity_group_id, "Actividad", class: "label" %>

                    <div class="select">
                        <%= f.input :legacy_activity_id,
                                    as: :select,
                                    label: false,
                                    collection: @activities.all.map{|l| [l.nombre, l.id]},
                                    selected: params[:legacy_activity_id],
                                    include_blank: true,
                                    input_html: { name: :legacy_activity_id }
                        %>
                    </div>
                </div>
            <% end %>
        </div>
    </div>
    <div class="field is-horizontal">
        <div class="field-body">
            <div class="control is-flex-grow-1 mr-2">
                    <%= f.input :nombres_str,
                                include_blank: true,
                                label: "Nombres y apellidos",
                                input_html: { name: :nombres_str, value: params[:nombres_str] }
                    %>
            </div>
            <div class="control is-narrow is-align-self-flex-end">
                <%= f.submit "Buscar", class: "button" %>
            </div>
        </div>
    </div>
<% end %>

<div class="my-2 has-text-right">
    <%=
        pluralize @legacy_person_activities.total_count, "registro", "registros"
    %>
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>Nº</th>
            <th>uuid</th>
            <th>Nombres</th>
            <th>Grupo</th>
            <th>Actividad</th>
            <th>Detalle</th>
            <th>Rango</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Duración</th>
        </tr>
    </thead>
    <tbody>
        <% @legacy_person_activities.each do |legacy_activity| %>
            <tr>
                <td>
                    <%= legacy_activity.row_number %>
                </td>
                <td>
                    <%= legacy_activity.id %>
                </td>
                <td>
                    <%= legacy_activity.legacy_person.nombres %>
                </td>
                <td>
                    <%= legacy_activity.legacy_activity_group.try(:nombre) %>
                </td>
                <td>
                    <%= legacy_activity.legacy_activity.try(:nombre) %>
                </td>
                <td>
                    <%= legacy_activity.legacy_activity_detail.try(:nombre) %>
                </td>
                <td>
                    <%= legacy_activity.activity_dates %>
                </td>
                <td>
                    <%= legacy_activity.start_date %>
                </td>
                <td>
                    <%= legacy_activity.end_date %>
                </td>
                <td>
                    <%= legacy_activity.duracion %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>

<div class="has-text-right">
    <%= @legacy_person_activities.limit_value %>
    por página
</div>

<%= paginate @legacy_person_activities %>
