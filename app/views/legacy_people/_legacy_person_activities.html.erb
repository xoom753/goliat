<%
    colspan = 5
%>

<% legacy_person_activities_by_group.each do |activity_group_id, legacy_person_activities| %>
    <tr>
        <td colspan="<%= colspan %>" align="center">
            <strong>
                <%= ActivityGroup.find(activity_group_id).nombre %>
            </strong>
        </td>
    </tr>

    <% legacy_person_activities.each do |legacy_person_activity| %>
        <tr>
            <td>
                <%= legacy_person_activity.legacy_activity.nombre %>
            </td>
            <td>
                <%= legacy_person_activity.legacy_activity_group.nombre %>
            </td>
            <td>
                <% if legacy_person_activity.legacy_activity_detail.present? %>
                    <%= legacy_person_activity.legacy_activity_detail.nombre %>
                <% end %>
            </td>
            <td>
                <%= legacy_person_activity.end_date %>
                <div class="is-size-7">
                    (<%= legacy_person_activity.end_date.strftime "%B %Y" %>)
                </div>
            </td>
            <td>
                <%= legacy_person_activity.duracion %>
            </td>
        </tr>
    <% end %>
<% end %>
<tr>
    <td class="has-text-centered is-size-7" colspan="<%= colspan %>">
        <%
            if @paginate_activitites && paged_legacy_person_activities.total_count > paged_legacy_person_activities.limit_value
        %>
            Mostrando <%= paged_legacy_person_activities.limit_value %> de <%= paged_legacy_person_activities.total_count %>.
            <%=
                view_all_path = if params[:legacy_people_ids].present?
                        view_several_legacy_people_path(legacy_people_ids: params[:legacy_people_ids])
                    else
                        legacy_person_path(legacy_person)
                    end
                link_to "Ver todos", view_all_path
            %>
        <% end %>
    </td>
</tr>
