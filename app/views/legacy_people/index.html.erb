<div class="has-text-centered">
    <h2>Lista PPL (histórica)</h2>
</div>

<%= form_tag legacy_people_path, method: :get do %>
    <div class="field has-addons">
        <div class="control is-expanded">
            <%= text_field_tag :q, params[:q], placeholder: "Buscar", class: "input" %>
        </div>
        <div class="control">
            <%= submit_tag "Buscar", class: "button" %>
        </div>
    </div>
<% end %>

<%= render "legacy_people_table" %>

<%= paginate @legacy_people %>
