<div class="has-text-centered">
    <h2>Lista PPL (archivo)</h2>
</div>

<%= form_tag legacy_people_path, method: :get do %>
    <div class="field has-addons">
        <div class="control is-expanded">
            <%= text_field_tag :q, @search_query, placeholder: "Buscar", class: "input" %>
        </div>
        <div class="control">
            <%= submit_tag "Buscar", class: "button" %>
        </div>
    </div>
<% end %>

<div class="my-2 has-text-right">
    <%=
        pluralize @legacy_people.total_count, "registro", "registros"
    %>
</div>

<%= render "legacy_people_table" %>

<div class="has-text-right">
    <%= @legacy_people.limit_value %>
    por página
</div>

<%= paginate @legacy_people %>
