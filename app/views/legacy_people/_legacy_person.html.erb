<%
    paged_legacy_person_activities = legacy_person.legacy_person_activities
                     .sorted_by_date

    if @paginate_activitites
        paged_legacy_person_activities = paged_legacy_person_activities.page(1)
                     .per(10)
    end

    legacy_person_activities_by_group =
        paged_legacy_person_activities
            .inject({}) do |memo, legacy_person_activity|
                activity_group_id = legacy_person_activity.legacy_activity_group.activity_group.id
                memo[activity_group_id] ||= []
                memo[activity_group_id] << legacy_person_activity
                memo
    end

    rows_span = legacy_person_activities_by_group.inject(2) do |memo, (k, values)|
        memo = memo + 1 # for each key
        memo = memo + values.length # activities count
        memo
    end
%>

<tr>
    <td rowspan="<%= rows_span %>">
        <%= legacy_person.id %>
    </td>
    <td rowspan="<%= rows_span %>">
        <%= legacy_person.nombres %>
        <div>
            <%= link_to "Nueva Ficha Ejes", new_person_ejes_resumen_path(legacy_person_id: legacy_person.id), class: "mt-2 button is-small is-rounded" %>
        </div>
    </td>
    <td rowspan="<%= rows_span %>">
        <%= legacy_person.dni %>
    </td>
</tr>

<%= render "legacy_person_activities",
           legacy_person_activities_by_group: legacy_person_activities_by_group,
           paged_legacy_person_activities: paged_legacy_person_activities,
           legacy_person: legacy_person
%>
