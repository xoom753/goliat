<div id="<%= dom_id legacy_course_file_parser %>">
  <div>
    <strong>Parser name:</strong>
    <%= legacy_course_file_parser.parser_name %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= legacy_course_file_parser.description %>
  </div>

  <div>
    <strong>Skip rows:</strong>
    <%= legacy_course_file_parser.skip_rows %>
  </div>

  <div>
    <strong>Nombres col:</strong>
    <%= legacy_course_file_parser.nombres_col %>
  </div>

  <div>
    <strong>Fechas cols:</strong>
    <%= legacy_course_file_parser.fechas_cols %>
  </div>

  <div>
    <strong>Sheets:</strong>
    <%= legacy_course_file_parser.sheet_numbers %>
  </div>

  <div>
    <strong>Empty rows for footer:</strong>
    <%= legacy_course_file_parser.emtpy_rows_for_footer_count %>
  </div>

  <div>
    <strong>Month name in each sheet:</strong>
    <%= legacy_course_file_parser.month_name_in_each_sheet %>
  </div>

  <% if legacy_course_file_parser.ignore_specific_rows.present? %>
    <div>
      <strong>Ignore specific rows:</strong>
      <% legacy_course_file_parser.ignore_specific_rows_array.each do |ignore_specific_row| %>
        <%= ignore_specific_row %> <br />
      <% end %>
    </div>
  <% end %>
</div>
