<div class="has-text-centered">
    <h2>Extranjeros presentes</h2>
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>uid</th>
            <th>Nombre</th>
            <th>Pasaporte</th>
            <th>PPL Presentes</th>
            <th>PPL Archivos</th>
        </tr>
    </thead>
    <tbody>
        <% @extranjeros_presentes.each do |extranjero_presente| %>
            <tr>
                <td>
                    <%= extranjero_presente.id %>
                </td>
                <td>
                    <%=
                        extranjero_presente.nombres
                    %>
                </td>
                <td>
                    <%= extranjero_presente.pasaporte %>
                </td>
                <td>
                    <% if extranjero_presente.person.present? %>
                        <%= link_to extranjero_presente.person.nombres.titleize,
                                    people_dashboard_path(person_id: extranjero_presente.person.id) %>
                    <% end %>
                </td>
                <td>
                    <% extranjero_presente.legacy_people.each do |legacy_person| %>
                        <%= link_to legacy_person.nombres.titleize,
                                    legacy_people_path(legacy_people_ids: extranjero_presente.legacy_people_ids) %>
                    <% end %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
