<h2 class="has-text-centered">
    Actividades presentes
</h2>

<div>
    <%= form_tag people_activities_path,
                 method: :get,
                 data: { controller: "auto-submit-form" } do %>
        <div class="field is-horizontal">
                    <div class="field-body">
                        <div class="field">
                            <div class="control">
                                <div class="select">
                                    <%= select_tag :activity_group_id,
                       options_from_collection_for_select(ActivityGroup.all, :id, :nombre, params[:activity_group_id]),
                      { include_blank: "Todos los ejes", data: {"auto-submit-form-target" => "selectTag"} } %>
                                </div>
                                <div class="select">
        <%= select_tag :activity_id,
                        options_from_collection_for_select(@activities, :id, :nombre, params[:activity_id]),
                        { include_blank: "Todas las actividades", data: {"auto-submit-form-target" => "selectTag"} } %>
                                </div>
                                <div class="select">
        <%= select_month @month.to_i, { include_blank: true }, {data: {"auto-submit-form-target" => "selectTag"} } %>
                                </div>
        <%= submit_tag "Buscar", data: {"auto-submit-form-target" => "submitBtn"} %>
    <% end %>
</div>

<div class="my-2 has-text-right">
    <%=
        pluralize @people_activities.total_count, "registro", "registros"
    %>
</div>

<table id=datatables class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>Eje</th>
            <th>Actividad</th>
            <th>Persona</th>
            <th>DNI</th>
            <th>Año</th>
            <th>Mes</th>
        </tr>
    </thead>
    <tbody>
    <% @people_activities.each do |person_activity| %>
        <tr>
            <td>
                <% if person_activity.coursable.is_a?(ExtraActivity) %>
                    Actividad Extra
                <% else %>
                    <%= person_activity.coursable.activity_group.nombre %>
                <% end %>
            </td>
            <td>
                <%= person_activity.coursable.nombre %>
            </td>
            <td>
                <%= person_activity.person.nombres %>
            </td>
            <td>
                <%= person_activity.person.dni %>
            </td>
            <td>
                <%= person_activity.anio %>
            </td>
            <td>
                <%= Date::MONTHNAMES[person_activity.mes] %>
            </td>
        </tr>
    <% end %>
    </tbody>
</table>

<div class="has-text-right">
    <%= @people_activities.limit_value %>
    por página
</div>

<%= paginate @people_activities %>
