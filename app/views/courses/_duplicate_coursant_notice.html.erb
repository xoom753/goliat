<%
    person = person_activity.person
    activity = person_activity.coursable
    courses_coursed = person.person_activities.where(mes: person_activity.mes, anio: person_activity.anio).where.not(coursable: activity)
%>
<% if courses_coursed.exists? %>
    <tr>
        <td class="has-background-danger-light">
            <i class="fa-solid fa-bomb"></i>
        </td>
        <td colspan="5" class="has-background-danger-light is-size-7">
            <%= person.nombres %>
            ya está en un curso:
            <% courses_coursed.each do |coursed| %>
                <div>
                    <%= coursed.coursable.nombre %>
                    <%= Date::MONTHNAMES[coursed.mes] %>
                    <%= coursed.anio %>
                    -
                    <%= coursed.cargo %>
                </div>
            <% end %>
        </td>
    </tr>
<% end %>
