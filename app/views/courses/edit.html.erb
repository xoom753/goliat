<h2 class="has-text-centered">
    <%= @activity.nombre %>
    ·
    <%= @activity.activity_group.nombre %>
</h2>
<h2 class="has-text-centered">
    <%= Date::MONTHNAMES[@month.to_i] %>
    <%= @year %>
</h2>

<%=
    form_tag edit_course_path(@activity),
             method: :get,
             class: "mb-2",
             data: { controller: "auto-submit-form" } do
%>
    <%= hidden_field_tag :activity_group_id, params[:activity_group_id] %>
    <div class="field is-horizontal">
        <div class="field-label is-normal">
            <label for="date_month" class="label">Filter Month / Year</label>
        </div>
        <div class="field-body">
            <div class="field">
                <div class="control">
                    <div class="select">
                        <%= select_month @month.to_i, {}, {data: {"auto-submit-form-target" => "selectTag"} } %>
                    </div>
                    <div class="select">
                        <%= select_year @year.to_i, {}, {data: {"auto-submit-form-target" => "selectTag"} } %>
                    </div>
                    <%= submit_tag "Filter", data: {"auto-submit-form-target" => "submitBtn"} %>
                </div>
            </div>
        </div>
    </div>
<% end %>

<div data-controller="add-person-to-course">
    <%= form_tag course_path,
                 method: :put,
                 data: {"add-person-to-course-target" => "form"} do %>
        <%= hidden_field_tag :month, @month %>
        <%= hidden_field_tag :year, @year %>
        <%= hidden_field_tag :person_id, nil, data: {"add-person-to-course-target" => "personInput"} %>

        <select data-add-person-to-course-target="select">
        </select>
    <% end %>
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>
                Nº
            </th>
            <th>
                Nombres
            </th>
            <th>
                DNI
            </th>
            <th>
                Cargo
            </th>
            <th>
                Pabellón
            </th>
            <th>
            </th>
        </tr>
    </thead>
    <tbody>
        <% @person_activities.each_with_index do |person_activity, index| %>
            <tr>
                <td>
                    <%= index + 1 %>
                </td>
                <td>
                    <%= person_activity.person.nombres %>
                </td>
                <td>
                    <%= person_activity.person.dni %>
                </td>
                <td>
                    <%= person_activity.cargo %>
                </td>
                <td>
                    <%= person_activity.person.pabellon %>
                </td>
                <td>
                    <%= link_to "Remove", course_path(person_activity_id: person_activity.id, month: @month, year: @year), data: { turbo_method: :delete } %>
                </td>
            </tr>
            <%= render "already_coursed_notice", person_activity: person_activity %>
            <%= render "duplicate_coursant_notice", person_activity: person_activity %>
        <% end %>
    </tbody>
</table>
