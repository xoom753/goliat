<div class="has-text-centered">
    <h2>Grupos de actividades (históricos)</h2>
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>uid</th>
            <th>Nombre</th>
            <th>Eje de tratamiento</th>
        </tr>
    </thead>
    <tbody>
        <% @legacy_activity_groups.each do |legacy_activity| %>
            <tr>
                <td>
                    <%= legacy_activity.id %>
                </td>
                <td>
                    <%= legacy_activity.nombre %>
                </td>
                <td>
                    <%= form_for legacy_activity,
                                 data: { controller: "auto-submit-form" } do |form| %>
                        <div class="select">
                            <%= form.select :activity_group_id,
                                            options_from_collection_for_select(ActivityGroup.all, :id, :nombre, legacy_activity.activity_group.try(:id)),
                                            { include_blank: true },
                                            {data: {"auto-submit-form-target" => "selectTag"}
                                            }
                            %>
                        </div>
                        <%= form.submit "Submit", data: {"auto-submit-form-target" => "submitBtn"} %>
                    <% end %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>

<%= paginate @legacy_activity_groups %>
