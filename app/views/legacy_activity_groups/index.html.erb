<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Activity Group</th>
        </tr>
    </thead>
    <tbody>
        <% @legacy_activity_groups.each do |legacy_activity| %>
            <tr>
                <td>
                    <%= legacy_activity.nombre %>
                </td>
                <td>
                    <%= legacy_activity.activity_group.nombre if legacy_activity.activity_group.present? %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
