@informe_renderer_service.docx = docx

@informe_renderer_service.generic_styles
@informe_renderer_service.header
@informe_renderer_service.footer

@informe_renderer_service.draft_template_title
@informe_renderer_service.draft_info_si_cumple
@informe_renderer_service.draft_info_no_cumple
@informe_renderer_service.draft_grades_si_cumple
@informe_renderer_service.draft_grades_no_cumple

docx.hr

@informe_renderer_service.draft_activities_list

docx.page

@informe_renderer_service.get_fichas_indexes.each do |index|
    activities_ficha = @informe_renderer_service.get_activities_ficha(index)

    activities_ficha.title
    activities_ficha.intro
    activities_ficha.info_table
    activities_ficha.info_summary
    activities_ficha.info_actividades_list
    activities_ficha.info_outro

    @informe_renderer_service.signature

    activities_ficha.encargado_title

    @informe_renderer_service.fecha_entrega

    docx.page

    grades_ficha = @informe_renderer_service.get_grades_ficha(index)

    grades_ficha.title
    grades_ficha.intro
    grades_ficha.info_table

    grades_ficha.grades_table
    grades_ficha.grades_summary

    @informe_renderer_service.signature

    grades_ficha.encargado_title

    @informe_renderer_service.fecha_entrega

    docx.page
end
