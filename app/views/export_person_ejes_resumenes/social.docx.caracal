@informe_renderer_service.docx = docx

@informe_renderer_service.generic_styles
@informe_renderer_service.header
@informe_renderer_service.footer

@informe_renderer_service.get_fichas_indexes.each do |index|
    activities_ficha = @informe_renderer_service.get_activities_ficha(index)

    activities_ficha.info_table

    grades_ficha = @informe_renderer_service.get_grades_ficha(index)

    docx.p "Parámetros de Evaluación".upcase, align: :center, bold: true
    docx.p

    grades_ficha.grades_table

    docx.p

    @informe_renderer_service.signature
    docx.p "Trabajadora Social CPL Loja 1".upcase, bold: true

    @informe_renderer_service.fecha_entrega

    docx.page
end
