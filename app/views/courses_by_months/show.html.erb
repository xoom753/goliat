<%
    date_params = {
        month: params.dig(:date, :month),
        year: params.dig(:date, :year)
    }
%>

<div class="tabs is-centered is-toggle">
    <ul class="ml-0">
        <li class="<%= "is-active" if params[:activity_group_id].blank? %>">
            <%=
                link_to "Todos",
                        courses_by_month_path(date: date_params),
                        class: "is-active"
            %>
        </li>
        <% ActivityGroup.all.each do |activity_group| %>
            <li class="<%= "is-active" if params[:activity_group_id] == activity_group.id.to_s %>">
                <%=
                    link_to activity_group.nombre,
                            courses_by_month_path(date: date_params, activity_group_id: activity_group.id),
                            class: "is-active"
                %>
            </li>
        <% end %>
    </ul>
</div>

<%=
    form_tag courses_by_month_path,
             method: :get,
             data: { controller: "auto-submit-form" } do
%>
    <%= hidden_field_tag :activity_group_id, params[:activity_group_id] %>
    <div class="field is-horizontal">
        <div class="field-label is-normal">
            <label for="date_month" class="label">Filter Month / Year</label>
        </div>
        <div class="field-body">
            <div class="field">
                <div class="control">
                    <div class="select">
                        <%= select_month @month.to_i, {}, {data: {"auto-submit-form-target" => "selectTag"} } %>
                    </div>
                    <div class="select">
                        <%= select_year @year.to_i, {}, {data: {"auto-submit-form-target" => "selectTag"} } %>
                    </div>
                    <%= submit_tag "Filter", data: {"auto-submit-form-target" => "submitBtn"} %>
                </div>
            </div>
        </div>
    </div>
<% end %>

<% @activity_groups.each do |activity_group| %>
    <h3>
        <%= activity_group.nombre %>
    </h3>
    <% activity_group.activities.each do |activity| %>
        <table class="table is-striped is-hoverable">
            <thead>
                <tr>
                    <th colspan="6" align=center>
                        <h4>
                            <%= activity.nombre %>
                        </h4>
                        <%= link_to "Edit",
                                    edit_course_path(activity, date: { month: @month, year: @year }) %>
                        ·
                        <%= link_to "Export",
                                    export_courses_by_month_path(activity_id: activity.id, date: { month: @month, year: @year}) %>
                    </th>
                </tr>
                <% if activity.person_activities.where(mes: @month, anio: @year).any? %>
                    <tr>
                        <th>
                            N
                        </th>
                        <th>
                            Nombres
                        </th>
                        <th>
                            DNI
                        </th>
                        <th>
                            Cargo
                        </th>
                        <th>
                            Pabellón
                        </th>
                        <th>
                            uuid
                        </th>
                    </tr>
                <% end %>
            </thead>
            <tbody>
                <% activity.person_activities.where(mes: @month, anio: @year).each_with_index do |person_activity, index| %>
                    <tr>
                        <td>
                            <%= index + 1 %>
                        </td>
                        <td>
                            <%= person_activity.person.nombres %>
                        </td>
                        <td>
                            <%= person_activity.person.dni %>
                        </td>
                        <td>
                            <%= person_activity.cargo %>
                        </td>
                        <td>
                            <%= person_activity.person.pabellon %>
                        </td>
                        <td>
                            <%= person_activity.id %>
                        </td>
                    </tr>
                <% end %>
            </tbody>
        </table>
        <hr />
    <% end %>
<% end %>
