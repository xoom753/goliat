<div class="content">
    <h2>Fichas</h2>

    <% @person_ejes_resumenes.each do |person_ejes_resumen| %>
        <div>
            <h3><%= person_ejes_resumen.nombres %></h3>
            <%= link_to "Cultural.docx", cultural_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %> ·
            <%= link_to "Deportivo.docx", deportivo_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %> ·
            <%= link_to "Laboral.docx", laboral_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %> ·
            <%= link_to "Certificados.csv", certificados_person_ejes_resumen_path(person_ejes_resumen, format: :csv) %>
        </div>

        <dl>
            <dt>
                DNI
            </dt>
            <dd>
                <%= person_ejes_resumen.dni %>
            </dd>

            <dt>
                Fecha pérdida libertad
            </dt>
            <dd>
                <%= person_ejes_resumen.fecha_perdida_libertad %>
            </dd>

            <dt>
                Ubicación
            </dt>
            <dd>
                <%= person_ejes_resumen.ubicacion %>
            </dd>

            <dt>
                Delitos
            </dt>
            <dd>
                <%= person_ejes_resumen.delitos_array.join("<br />").html_safe %>
            </dd>

            <dt>
                Sentencias
            </dt>
            <dd>
                <%= person_ejes_resumen.sentencias_array.join("<br />").html_safe %>
            </dd>

            <% if person_ejes_resumen.acumulacion_penas.present? %>
                <dt>
                    Acumulación de penas
                </dt>
                <dd>
                    <%= person_ejes_resumen.acumulacion_penas %>
                </dd>
            <% end %>

            <% if person_ejes_resumen.tipo_porcentual? %>
                <%
                    renderer = PersonEjeResumenRenderService.new(person_ejes_resumen)
                    periodos_porcentuales = renderer.periodos_porcentuales
                %>
                <% periodos_porcentuales.each do |key, periodos| %>
                    <dt>
                        <%= key %>
                    </dt>
                    <dd>
                        <%= periodos.first[:start_date] %> -
                        <%= periodos.first[:end_date] %>
                    </dd>
                <% end %>
            <% else %>
                <%
                    renderer = PersonEjeResumenRenderService.new(person_ejes_resumen)
                    semestres_detail_hash = begin
                        renderer.semestres_detail_hash
                    rescue StandardError => e
                        { "error" => [{ "error" => e }] }
                    end
                %>

                <% semestres_detail_hash.each do |key, values| %>
                    <dt>
                        <%= key %>
                    </dt>
                    <dd>
                        <%=
                            values_strs = values.map do |val|
                                "#{val[:percentage]} - #{val[:semestre_str]}: #{val[:start_date]} - #{val[:end_date]}"
                            end
                            values_strs.join("<br />").html_safe
                        %>
                    </dd>
                <% end %>
            <% end %>

            <% if person_ejes_resumen.legacy_people_ids.present? %>
                <dt>
                    Legacy People for report
                </dt>
                <dd>
                    <%=
                        people_links_str = person_ejes_resumen.legacy_people.map do |legacy_person|
                            link_to "#{legacy_person.id} - #{legacy_person.nombres}",
                                    legacy_people_path(legacy_people_ids: person_ejes_resumen.legacy_people_ids),
                                    target: "_blank"
                        end
                        people_links_str.join("<br />").html_safe
                    %>
                </dd>
            <% end %>

            <% if person_ejes_resumen.people_ids.present? %>
                <dt>
                    Present people for report
                </dt>
                <dd>
                    <%=
                        people_links_str = person_ejes_resumen.people.map do |person|
                            link_to "#{person.id} - #{person.nombres}",
                                    people_dashboard_path(person_id: person.id),
                                    target: "_blank"
                        end
                        people_links_str.join("<br />").html_safe
                    %>
                </dd>
            <% end %>
        </dl>

        <hr />
    <% end %>
</div>
