<div class="has-text-centered">
    <h2>Fichas</h2>
</div>

<% @person_ejes_resumenes.each do |person_ejes_resumen| %>
    <div data-controller="toggable-content">
        <div class="mb-3">
            <h3><%= person_ejes_resumen.nombres.titleize %></h3>
            <%= link_to "Cultural.docx", cultural_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %> ·
            <%= link_to "Deportivo.docx", deportivo_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %> ·
            <%= link_to "Laboral.docx", laboral_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %> ·
            <%= link_to "Educativo.docx", educativo_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %> ·
            <%= link_to "Certificados.csv", certificados_person_ejes_resumen_path(person_ejes_resumen, format: :csv) %> ·
            <%= link_to "Certificados.docx", certificados_person_ejes_resumen_path(person_ejes_resumen, format: :docx) %>
        </div>

        <dl class="mb-0">
            <% if person_ejes_resumen.last_generated_at.present? %>
                <dt>
                    Generado por última vez
                </dt>
                <dd>
                    <%= person_ejes_resumen.last_generated_at %>
                </dd>
            <% end %>
            <% if person_ejes_resumen.people_ids.present? %>
                <dt>
                    PPL presentes para reporte
                </dt>
                <dd>
                    <%=
                        people_links_str = person_ejes_resumen.people.map do |person|
                            link_to "#{person.id} - #{person.nombres}",
                                    people_dashboard_path(person_id: person.id),
                                    target: "_blank"
                        end
                        people_links_str.join("<br />").html_safe
                    %>
                </dd>
            <% end %>
            <% if person_ejes_resumen.legacy_people_ids.present? %>
                <dt>
                    Lista PPL (archivos) para reporte
                </dt>
                <dd>
                    <%=
                        people_links_str = person_ejes_resumen.legacy_people.map do |legacy_person|
                            link_to "#{legacy_person.id} - #{legacy_person.nombres}",
                                    legacy_people_path(legacy_people_ids: person_ejes_resumen.legacy_people_ids),
                                    target: "_blank"
                        end
                        people_links_str.join("<br />").html_safe
                    %>
                </dd>
            <% end %>
        </dl>

        <dl>
            <div class="is-hidden" data-toggable-content-target="hiddenContent">
                <dt>
                    DNI
                </dt>
                <dd>
                    <%= person_ejes_resumen.dni %>
                </dd>

                <dt>
                    Tipo
                </dt>
                <dd>
                    <%=
                        if person_ejes_resumen.tipo_porcentual?
                            "Porcentual"
                        else
                            "Semestral"
                        end
                    %>
                </dd>

                <dt>
                    Fecha pérdida libertad
                </dt>
                <dd>
                    <%= person_ejes_resumen.fecha_perdida_libertad %>
                </dd>

                <dt>
                    Ubicación
                </dt>
                <dd>
                    <%= person_ejes_resumen.ubicacion %>
                </dd>

                <dt>
                    Delitos
                </dt>
                <dd>
                    <%= person_ejes_resumen.delitos_array.join("<br />").html_safe %>
                </dd>

                <dt>
                    Sentencias
                </dt>
                <dd>
                    <%= person_ejes_resumen.sentencias_array.join("<br />").html_safe %>
                </dd>

                <% if person_ejes_resumen.acumulacion_penas.present? %>
                    <dt>
                        Acumulación de penas
                    </dt>
                    <dd>
                        <%= person_ejes_resumen.acumulacion_penas %>
                    </dd>
                <% end %>

                <% if person_ejes_resumen.tipo_porcentual? %>
                    <% periodos = ::PersonEjesResumen::PeriodosRendererService.new(kind: :cultural, person_ejes_resumen: person_ejes_resumen).periodos %>
                    <% periodos.each do |periodo| %>
                        <dt><%= periodo.period_percentage %></dt>
                        <dd><%= periodo.start_date_str %> - <%= periodo.end_date_str %></dd>
                    <% end %>
                <% else %>
                <%
                    periodos = ::PersonEjesResumen::PeriodosRendererService.new(kind: :cultural, person_ejes_resumen: person_ejes_resumen).periodos
                    periodos_semestrales = periodos.inject({}) do |memo, periodo|
                        memo[periodo.period_percentage] ||= []
                        memo[periodo.period_percentage] << periodo
                        memo
                    end
                %>
                    <% periodos_semestrales.each do |percentage, periodos| %>
                        <dt><%= percentage %></dt>
                        <% periodos.each do |periodo| %>
                            <dd>
                                <%= "#{periodo.percentage} => " %>
                                <%= periodo.start_date_str %> - <%= periodo.end_date_str %> ·
                                <%= "#{periodo.semestre_str}"%>
                            </dd>
                        <% end %>
                    <% end %>
                <% end %>
            </div>
        </dl>

        <a href="#" data-toggable-content-target="showDetails" class="mr-3 button is-rounded is-small">
            Mostrar detalles
        </a>

        <%= link_to "Editar", edit_person_ejes_resumen_path(person_ejes_resumen), class: "button is-rounded is-small" %>
    </div>
    <hr />
<% end %>

<%= paginate @person_ejes_resumenes %>
