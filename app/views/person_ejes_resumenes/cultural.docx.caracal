@informe_renderer_service.docx = docx
@informe_renderer_service.kind = :cultural

@informe_renderer_service.generic_styles

@informe_renderer_service.header

@informe_renderer_service.footer

@render_service.semestres_detail_hash.each do |semestre, periods|
    periods.each do |period|
        @informe_renderer_service.period = period
        @informe_renderer_service.semestre = semestre

        @informe_renderer_service.ficha_info_title

        @informe_renderer_service.ficha_info_intro

        @informe_renderer_service.ficha_info_table

        @informe_renderer_service.ficha_info_summary

        @informe_renderer_service.ficha_info_actividades

        @informe_renderer_service.ficha_info_outro

        @informe_renderer_service.signature

        @informe_renderer_service.encargado_title

        @informe_renderer_service.fecha_entrega

        docx.page

        @informe_renderer_service.ficha_qualy_title

        @informe_renderer_service.ficha_qualy_intro

        @informe_renderer_service.ficha_qualy_info_table

        @informe_renderer_service.ficha_qualy_main_table

        @informe_renderer_service.ficha_qualy_summary

        @informe_renderer_service.signature

        @informe_renderer_service.encargado_title

        @informe_renderer_service.fecha_entrega

        docx.page
    end
end
