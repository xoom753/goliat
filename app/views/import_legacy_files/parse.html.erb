<h2>
    filename: <%= @legacy_import_file.filename %>
</h2>
<h2>
    path: <%= @legacy_import_file.filepath %>
</h2>
<h2>
    modified at <%= @legacy_import_file.last_modified_at_time %>
</h2>
<div>
    <%= form_tag update_parser_import_legacy_files_path(id: @legacy_import_file.id), method: :put do %>
        <%= select_tag :parseable_id_and_type,
                       options_from_collection_for_select(LegacyFilesParser.all + LegacyCourseFileParser.all, :id_and_type, :parser_name, @legacy_import_file.parseable_id_and_type), include_blank: true %>
        <%= submit_tag "Update parser" %>
    <% end %>
</div>

<% if @legacy_import_file.parseable.is_a?(LegacyCourseFileParser) %>
    <hr />

    <%= form_tag parse_import_legacy_files_path, method: :get do %>
        <%= hidden_field_tag :id, @legacy_import_file.id %>
        <div>
            <%= label_tag :grupo, "Grupo" %>
            <%= text_field_tag :grupo, params[:grupo], placeholder: "Ej: Laboral" %>
        </div>
        <div>
            <%= label_tag :actividad, "Actividad" %>
            <%= text_field_tag :actividad, params[:actividad], placeholder: "Ej: Electricidad Básica" %>
        </div>
        <div>
            <%= label_tag :detalle, "Detalle" %>
            <%= text_field_tag :detalle, params[:detalle], placeholder: "Ej: Servicios auxiliares" %>
        </div>
        <div>
            <%= label_tag :rango, "Rango" %>
            <%= text_field_tag :rango, params[:rango], placeholder: "Ej: 01-12-2023 AL 29-12-2023" %>
        </div>
        <div>
            <%= label_tag :hasta, "Hasta (fecha final)" %>
            <%= date_field_tag :hasta, params[:hasta], placeholder: "Hasta" %>
        </div>
        <div>
            <%= label_tag :duracion, "Duración" %>
            <%= text_field_tag :duracion, params[:duracion], placeholder: "Ej: 30 horas" %>
        </div>
        <%= submit_tag %>
    <% end %>

    <hr />

    <table class="table is-striped is-hoverable is-narrow">
        <thead>
            <tr>
                <th>Headers</th>
            </tr>
        </thead>
        <tbody>
            <% @file_headers.each do |header_row| %>
                <tr>
                    <% header_row.compact.each do |col| %>
                        <td>
                            <%=
                                col.is_a?(String) ? col.titleize : col
                            %>
                        </td>
                    <% end %>
                </tr>
            <% end %>
        </tbody>
    </table>
<% end %>

<% if @legacy_person_activities.present? %>
    <table class="table is-striped is-hoverable">
        <thead>
            <tr>
                <th>Nº</th>
                <th>Nombres</th>
                <th>Grupo</th>
                <th>Actividad</th>
                <%
                    if @legacy_import_file.parseable.is_a?(LegacyFilesParser) && @legacy_import_file.parseable.activity_detail_str.present?
                %>
                    <th>Detalle</th>
                <% end %>
                <th>Rango</th>
                <th>Desde</th>
                <th>Hasta</th>
                <th>Duración</th>
            </tr>
        </thead>
        <tbody>
            <% @legacy_person_activities.each do |legacy_person_activity| %>
                <tr>
                    <td>
                        <%= legacy_person_activity.row_number %>
                    </td>
                    <td>
                        <%= legacy_person_activity.nombres_str %>
                    </td>
                    <td>
                        <%= legacy_person_activity.activity_group_str %>
                    </td>
                    <td>
                        <%= legacy_person_activity.activity_str %>
                    </td>
                    <%
                        if @legacy_import_file.parseable.is_a?(LegacyFilesParser) && @legacy_import_file.parseable.activity_detail_str.present?
                    %>
                        <td>
                            <%= legacy_person_activity.activity_detail_str %>
                        </td>
                    <% end %>
                    <td>
                        <%= legacy_person_activity.activity_dates %>
                    </td>
                    <td>
                        <%= legacy_person_activity.start_date %>
                    </td>
                    <td>
                        <%= legacy_person_activity.end_date %>
                    </td>
                    <td>
                        <%= legacy_person_activity.duracion %>
                    </td>
                </tr>
            <% end %>
        </tbody>
    </table>
<% end %>

<% if @legacy_import_file.parseable.present? %>
    <%= form_tag import_records_import_legacy_files_path(id: @legacy_import_file.id) do %>
        <%= hidden_field_tag :grupo, params[:grupo], placeholder: "Grupo" %>
        <%= hidden_field_tag :actividad, params[:actividad], placeholder: "Actividad" %>
        <%= hidden_field_tag :detalle, params[:detalle], placeholder: "detalle" %>
        <%= hidden_field_tag :rango, params[:rango], placeholder: "Rango" %>

        <%= hidden_field_tag :hasta, params[:hasta], placeholder: "Hasta" %>
        <%= hidden_field_tag :duracion, params[:duracion], placeholder: "Duración" %>
        <%= @legacy_person_activities.count %> records
        <%= submit_tag "Import records" %>
    <% end %>
<% end %>
