<div class="has-text-centered">
    <h2>Extra activities</h2>
</div>

<div class="has-text-right">
    <%= link_to "New Extra Activity",
                new_extra_activity_path,
                class: "button is-ghost" %>
</div>

<table class="table is-striped is-hoverable">
    <tbody>
        <% @extra_activities.each do |activity| %>
            <tr>
                <td>
                    <%= activity.nombre %>
                </td>
                <td>
                    <%= activity.created_at %>
                </td>
                <td>
                    <%= link_to "Edit",
                                edit_extra_activity_path(activity) %>
                    ·
                    <%= link_to "Export",
                                export_extra_activity_path(activity) %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
