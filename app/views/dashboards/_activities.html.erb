<% @activity_groups.each do |activity_group| %>

    <%
        missing_cols = max_activities_count - activity_group.activities.count
    %>

    <%
        coursed_group_status = person.person_activities.where(coursable: activity_group.activities).exists? ? "has-background-success-light" : "has-background-warning-light"
    %>
    <tr>
        <td align=center colspan="<%= max_activities_count %>" class="has-text-weight-semibold <%= coursed_group_status %>">
            <%= activity_group.nombre %>
        </td>
    </tr>

    <tr>
        <% activity_group.activities.each do |activity| %>
            <%
                coursed_status = activity.person_activities.where(person: person).exists? ? "has-background-success-light" : "has-background-warning-light"
            %>
            <td align=center class="<%= coursed_status %>">
                <%= activity.nombre %>
            </td>
        <% end %>
        <% 1.upto(missing_cols).each do %>
            <td class=""></td>
        <% end %>
    </tr>

    <tr>
        <% activity_group.activities.each do |activity| %>
            <% person_activities = activity.person_activities.where(person: person) %>
            <% coursed_status = activity.person_activities.where(person: person).exists? ? "has-background-success-light" : "has-background-warning-light" %>
            <td class="<%= coursed_status %>">
                <% if person_activities.empty? %>
                    -
                <% end %>
                <ul>
                    <% person_activities.each do |person_activity| %>
                        <li>
                            <%= Date::MONTHNAMES[person_activity.mes] %>
                            <%= person_activity.anio %>:
                            <%= person_activity.cargo %>
                        </li>
                    <% end %>
                </ul>
            </td>
        <% end %>
        <% 1.upto(missing_cols).each do %>
            <td class=""></td>
        <% end %>
    </tr>
<% end %>
