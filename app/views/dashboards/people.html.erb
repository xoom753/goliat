<div class="has-text-centered">
    <h2>People</h2>
</div>

<%=
    simple_form_for :people_dashboard_path,
                    url: people_dashboard_path,
                    method: :get do |f|
%>
  <div class="field has-addons">
    <div class="control is-expanded">
        <%=
            f.input :s,
                    label: false,
                    placeholder: "Buscar",
                    input_html: { name: :s, value: params[:s] },
                    wrapper: false
        %>
    </div>
    <div class="control">
        <%= f.submit "Buscar", class: "button" %>
    </div>
  </div>
<% end %>

<%
    max_activities_count = @activity_groups.map{|ag|
        ag.activities.count
    }.max
%>

<table class="table is-striped is-hoverable is-narrow dashboard-people-table mt-2">
    <thead>
        <tr class="">
            <th>
                Nombres
            </th>
            <th>
                DNI
            </th>
            <th>
                Pabellón
            </th>
            <th align=center colspan="<%= max_activities_count %>">
                Ejes
            </th>
        </tr>
    </thead>
    <tbody>
        <% @people.each do |person| %>
            <tr>
                <td rowspan=10 class="">
                    <div>
                        <%= person.nombres %>
                    </div>
                    <div>
                        <%=
                            link_to "Ver procesos",
                            origin_people_path(s: person.nombres)
                        %>
                    </div>
                    <div>
                        ID: <%= person.id %>
                    </div>
                </td>
                <td rowspan=10 class="">
                    <div>
                        <%= person.dni %>
                    </div>
                    <div>
                        <%=
                            link_to "Ver procesos",
                            origin_people_path(s: person.dni)
                        %>
                    </div>
                </td>
                <td rowspan=10 class="">
                    <%= person.pabellon %>
                </td>
            </tr>

            <%= render "activities", person: person, max_activities_count: max_activities_count %>
        <% end %>
    </tbody>
</table>

<%= paginate @people %>
