<%
    filter_params = {
        s: params[:s]
    }
%>

<div class="has-text-centered">
    <% if action_name == "people_presente" %>
        <h2>PPL presentes</h2>
    <% else %>
        <h2>Todas las PPL</h2>
    <% end %>
</div>

<% if action_name != "people_presente" %>
    <div class="tabs is-centered is-toggle">
        <ul class="ml-0">
            <li class="<%= "is-active" if params[:estado].blank? %>">
                <%=
                    link_to "Todos",
                            people_dashboard_path(filter_params),
                            class: "is-active"
                %>
            </li>
            <% Person.estados.each do |estado, value| %>
                <li class="<%= "is-active" if params[:estado] == value.to_s %>">
                    <%=
                        link_to estado.titleize,
                                people_dashboard_path(filter_params.merge(estado: value)),
                                class: "is-active"
                    %>
                </li>
            <% end %>
        </ul>
    </div>
<% end %>

<%=
    simple_form_for :people_dashboard_path,
                    url: request.path_info,
                    method: :get do |f|
%>
  <%= hidden_field_tag :estado, params[:estado] %>
  <div class="field has-addons">
    <div class="control is-expanded">
        <%=
            f.input :s,
                    label: false,
                    placeholder: "Buscar",
                    input_html: { name: :s, value: @search_query },
                    wrapper: false
        %>
    </div>
    <div class="control">
        <%= f.submit "Buscar", class: "button" %>
    </div>
  </div>
<% end %>

<%
    max_activities_count = @activity_groups.map{|ag|
        ag.activities.count
    }.max

    ##
    # rows:
    #   eje title, activities row, person_activities row
    person_name_rowspan = 1 + (@activity_groups.count * 3)
%>

<table class="table is-striped is-hoverable is-narrow dashboard-people-table mt-2">
    <thead>
        <tr class="">
            <th>
                Nombres
            </th>
            <th>
                DNI
            </th>
            <th>
                Pabellón
            </th>
            <th align=center colspan="<%= max_activities_count %>">
                Ejes
            </th>
        </tr>
    </thead>
    <tbody>
        <% @people.each do |person| %>
            <tr>
                <td rowspan="<%= person_name_rowspan %>" class="">
                    <div>
                        <%= person.nombres.titleize %>
                    </div>
                    <div>
                        <%=
                            link_to "Ver procesos",
                            origin_people_path(s: person.nombres)
                        %>
                    </div>
                    <div class="is-size-7">
                        uid: <%= person.id %>
                    </div>
                </td>
                <td rowspan="<%= person_name_rowspan %>" class="">
                    <div>
                        <%= person.dni %>
                    </div>
                    <div>
                        <%=
                            link_to "Ver procesos",
                            origin_people_path(s: person.dni)
                        %>
                    </div>
                </td>
                <td rowspan="<%= person_name_rowspan %>" class="">
                    <%= person.pabellon %> -
                    <%= person.celda %>
                </td>
            </tr>

            <%= render "activities", person: person, max_activities_count: max_activities_count %>
        <% end %>
    </tbody>
</table>

<%= paginate @people %>
