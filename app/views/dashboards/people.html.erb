<%= form_tag people_dashboard_path, method: :get do %>
    <%= text_field_tag :s, params[:s], placeholder: "Buscar" %>
<% end %>

<table class="table is-striped is-hoverable is-narrow is-bordered">
    <thead>
        <tr class="is-success">
            <th>
                Nombres
            </th>
            <th>
                DNI
            </th>
            <th>
                Pabellón
            </th>
            <% @activity_groups.each do |activity_group| %>
                <th align=center colspan="<%= activity_group.activities.count %>">
                    <%= activity_group.nombre %>
                </th>
            <% end %>
        </tr>
    </thead>
    <tbody>
        <% @people.each do |person| %>
            <tr>
                <td rowspan=3 class="is-success">
                    <%= person.nombres %>
                </td>
                <td rowspan=3 class="is-success">
                    <%= person.dni %>
                </td>
                <td rowspan=3 class="is-success">
                    <%= person.pabellon %>
                </td>
                <% @activity_groups.each do |activity_group| %>
                    <%
                        coursed_group_status = person.person_activities.where(coursable: activity_group.activities).exists? ? "is-primary" : "is-warning"
                    %>
                    <td align=center colspan="<%= activity_group.activities.count %>" class="<%= coursed_group_status %>">
                        <%= activity_group.nombre %>
                    </td>
                <% end %>
            </tr>
            <tr>
                <% @activity_groups.each do |activity_group| %>
                    <% activity_group.activities.each do |activity| %>
                        <%
                            coursed_status = activity.person_activities.where(person: person).exists? ? "is-primary" : "is-warning"
                        %>
                        <td align=center class="<%= coursed_status %>">
                            <%= activity.nombre %>
                        </td>
                    <% end %>
                <% end %>
            </tr>
            <tr>
                <%= render "activities", person: person %>
            </tr>
        <% end %>
    </tbody>
</table>

<%= paginate @people %>
