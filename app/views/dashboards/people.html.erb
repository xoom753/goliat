<%= form_tag people_dashboard_path, method: :get do %>
    <%= text_field_tag :s, params[:s], placeholder: "Buscar" %>
<% end %>

<%
    max_activities_count = @activity_groups.map{|ag|
        ag.activities.count
    }.max
%>

<table class="table is-striped is-hoverable is-narrow is-bordered">
    <thead>
        <tr class="is-success">
            <th>
                Nombres
            </th>
            <th>
                DNI
            </th>
            <th>
                Pabellón
            </th>
            <th align=center colspan="<%= max_activities_count %>">
                Ejes
            </th>
        </tr>
    </thead>
    <tbody>
        <% @people.each do |person| %>
            <tr>
                <td rowspan=10 class="is-success">
                    <div>
                        <%= person.nombres %>
                    </div>
                    <div>
                        <%=
                            link_to "Ver procesos",
                            origin_people_path(s: person.nombres)
                        %>
                    </div>
                </td>
                <td rowspan=10 class="is-success">
                    <div>
                        <%= person.dni %>
                    </div>
                    <div>
                        <%=
                            link_to "Ver procesos",
                            origin_people_path(s: person.dni)
                        %>
                    </div>
                </td>
                <td rowspan=10 class="is-success">
                    <%= person.pabellon %>
                </td>
            </tr>

            <%= render "activities", person: person, max_activities_count: max_activities_count %>
        <% end %>
    </tbody>
</table>

<%= paginate @people %>
