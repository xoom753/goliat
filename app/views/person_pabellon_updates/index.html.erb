<div class="has-text-centered">
    <h2>Actualizaciones de pabellones pendientes</h2>
</div>

<div class="has-text-right">
    <%= link_to "Nuevas actualizaciones", new_person_pabellon_update_path, class: "button is-ghost" %>
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>uuid</th>
            <th>Nombres</th>
            <th>Pabellón</th>
            <th>Fecha registro</th>
        </tr>
    </thead>
    <tbody class="table is-striped is-hoverable is-narrow">
        <% PersonPabellonUpdate.all.each do |update| %>
            <tr>
                <td>
                    <%= update.id %>
                </td>
                <td>
                    <%= update.nombres %>
                </td>
                <td>
                    <% pabellon_service = Person::PabellonParserService.new(
                            update
                        )
                    %>
                    <%= pabellon_service.pabellon.titleize %>
                    <%= pabellon_service.celda.titleize %>
                </td>
                <td>
                    <%= update.created_at %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
