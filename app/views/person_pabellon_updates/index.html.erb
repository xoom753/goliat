<div class="has-text-centered">
    <h2>Actualizaciones de pabellones pendientes</h2>
</div>

<div class="has-text-right">
    <%= link_to "Nuevas actualizaciones", new_person_pabellon_update_path, class: "button is-ghost" %>
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>uuid</th>
            <th>Nombres</th>
            <th>Pabellón</th>
            <th>Celda</th>
            <th>Fecha registro</th>
            <th></th>
        </tr>
    </thead>
    <tbody class="table is-striped is-hoverable is-narrow">
        <% PersonPabellonUpdate.all.each do |update| %>
            <tr>
                <td>
                    <%= update.id %>
                </td>
                <td contenteditable
                    data-controller="person-pabellon-update-nombre-editable"
                    data-person-pabellon-update-nombre-editable-pabellon-update-value="<%= update.id %>"
                    data-action= "input->person-pabellon-update-nombre-editable#willUpdate"
                >
                    <%= update.nombres %>
                </td>
                <td>
                    <%= update.pabellon %>
                </td>
                <td>
                    <%= update.celda %>
                </td>
                <td>
                    <%= update.created_at %>
                </td>
                <td>
                    <%=
                        link_to "Buscar información jurídica",
                                origin_people_path(s: update.nombres),
                                target: "_blank"
                    %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>
