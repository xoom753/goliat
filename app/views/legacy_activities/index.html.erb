<div class="has-text-centered">
    <h2>Actividades (archivo)</h2>
</div>

<%=
    simple_form_for :legacy_activities_path,
                    url: legacy_activities_path,
                    method: :get do |f|
%>
  <div class="field has-addons">
    <div class="control is-expanded">
        <%=
            f.input :s,
                    label: false,
                    placeholder: "Buscar",
                    input_html: { name: :s, value: params[:s] },
                    wrapper: false
        %>
    </div>
    <div class="control">
        <%= f.submit "Buscar", class: "button" %>
    </div>
  </div>
<% end %>

<div class="has-text-right">
    <%= pluralize @legacy_activities.total_count, "actividad", "actividades" %>
    en total
</div>

<table class="table is-striped is-hoverable">
    <thead>
        <tr>
            <th>uid</th>
            <th>Nombre (revisado)</th>
            <th>Nombre (original)</th>
        </tr>
    </thead>
    <tbody>
        <% @legacy_activities.each do |legacy_activity| %>
            <tr>
                <td>
                    <%= legacy_activity.id %>
                </td>
                <td>
                    <%=
                        ortography_fixer = PersonEjesResumen::ActivityToHumanRendererService::OrtographyFixer.new(
                            actividad_str: legacy_activity.nombre
                        )
                        ortography_fixer.activity_str
                    %>
                </td>
                <td>
                    <%= legacy_activity.nombre %>
                </td>
            </tr>
        <% end %>
    </tbody>
</table>

<div class="has-text-right">
    <%= @legacy_activities.limit_value %>
    por página
</div>

<%= paginate @legacy_activities %>
